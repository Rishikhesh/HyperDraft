{
  "name": "hyperdraft",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel dev:web dev:api",
    "dev:web": "vite",
    "dev:api": "bun --watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "bun server/index.ts",
