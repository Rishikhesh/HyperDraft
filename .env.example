# Server-side only. Never prefix with VITE_ (that ships them to the browser).
TYPESAFE_API_KEY=

# All models come through OpenRouter: one key for many models, paid and
# ":free" (openrouter.ai/models). Set a credit limit on the key: every
# visitor's page is billed to it. Each call logs its cost.
OPENROUTER_API_KEY=

# OpenRouter model ids, tried in order when one is busy.
# Free first, then cheap paid ones (~$0.01-0.03 a page)
LLM_MODELS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,deepseek/deepseek-v4.1-flash,z-ai/glm-5.3-flash

# Optional: models per job, each falling back to LLM_MODELS.
# plan: designs the page (strongest model; thinks first). One call a
# page, where the strongest model pays off (~$0.04)
# build: writes the UI (fast); edit: changes it (fastest)
LLM_PLAN_MODELS=google/gemini-3.5-flash,nvidia/nemotron-3-ultra-550b-a55b:free,deepseek/deepseek-v4.1-flash
# LLM_BUILD_MODELS=
# LLM_EDIT_MODELS=
# Seconds of silence before a model is given up on, in ms (default 30s,
# 90s for plan). Per job: LLM_PLAN_IDLE_MS, LLM_BUILD_IDLE_MS, …
# LLM_IDLE_MS=30000

# --- Production (all optional) ---
# PORT=3001
# Chat messages per visitor per minute (each one uses AI quota)
# RATE_LIMIT_PER_MINUTE=10
# Set to true behind a proxy/host (Fly, Render, nginx) so the rate limit
# sees visitors' real IPs from X-Forwarded-For
# TRUST_PROXY=false
