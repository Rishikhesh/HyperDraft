# Server-side only. Never prefix with VITE_ (that ships them to the browser).
TYPESAFE_API_KEY=

# LLM providers (free tiers). Keys from aistudio.google.com and
# build.nvidia.com. A provider without a key is skipped.
GOOGLE_API_KEY=
NVIDIA_API_KEY=

# Tried in order when one is busy. Format: provider:model
LLM_MODELS=nvidia:nvidia/nemotron-3-super-120b-a12b,google:gemini-3.1-flash-lite,google:gemma-4-26b-a4b-it

# --- Production (all optional) ---
# PORT=3001
# Chat messages per visitor per minute (each one uses AI quota)
# RATE_LIMIT_PER_MINUTE=10
# Set to true behind a proxy/host (Fly, Render, nginx) so the rate limit
# sees visitors' real IPs from X-Forwarded-For
# TRUST_PROXY=false
